# Copy to .env and fill in. Get a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Optional overrides (defaults shown)
# NLQ_MODEL=claude-opus-5
# NLQ_DB_PATH=data/bse.db
# NLQ_MAX_ROWS=200

# Resilience: a second model to fall through to when the primary is rate
# limited or down. Unset = no fallback.
# NLQ_FALLBACK_MODEL=claude-haiku-4-5

# Governance: columns no generated query may read (comma-separated). Turning
# this on also bans SELECT *, which would otherwise be the way around it.
# NLQ_RESTRICTED_COLUMNS=email

# Operations
# NLQ_AUDIT_LOG_PATH=data/audit.jsonl   # append-only JSONL trail; unset = log only
# NLQ_TOTAL_DEADLINE_SECONDS=120        # end-to-end budget for one question
# NLQ_CACHE_TTL_SECONDS=300             # 0 disables the repeat-question cache
# NLQ_LOG_LEVEL=WARNING                 # the audit trail is exempt: always logged
