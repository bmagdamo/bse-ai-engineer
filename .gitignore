# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Project
# Ignore every .env variant, plus editor swap/backup files that can contain
# the secrets those files hold. .env.example is the checked-in template.
.env
.env.*
!.env.example
data/*.db
.pytest_cache/
.ruff_cache/

# Editor / OS noise (a .env.swp would otherwise leak a key)
*.swp
*.swo
*~
.DS_Store

# Assignment brief (not ours to redistribute)
*.pdf
